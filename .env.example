# Obrigatória. Em dev aponta para o container de `make db-up`.
DATABASE_URL=postgres://agro:agro_dev@localhost:5435/agro?sslmode=disable
# Porta da API (em `make up`/`make dev` vale DEV_API_PORT do Makefile).
PORT=8080
# json (padrão) ou text.
LOG_FORMAT=json
# false só para acessar o servidor de dev por http a partir de outro aparelho na rede.
COOKIE_SECURE=true
# Pasta do frontend compilado; vazia, a API não serve páginas (o Vite serve em dev).
STATIC_DIR=
# Com chave, o ditado usa a transcrição da OpenAI (a mesma do CSF). Sem chave, o navegador
# usa o reconhecimento de voz próprio (Chrome/Edge/Safari).
OPENAI_API_KEY=
